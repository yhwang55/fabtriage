# Copy to .env and fill in. Never commit .env.
# Meta Model API (Muse Spark 1.3 for the agent, SAM 3.1 for wafer maps)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
SAM_MODEL=sam-3.1
# Baseten (Muse Spark Open, for batch benchmark runs)
BASETEN_API_KEY=
# Llama 3.3 70B deployed from the Baseten model library (optional, for the model comparison)
# LLAMA_BASE_URL=https://model-xxxxxxxx.api.baseten.co/environments/production/sync/v1
# LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Optional overrides
# AGENT_MODEL=muse-spark-1.3
# MAX_TURNS=16
# WAFERMAP_SEGMENTER=sam   # or local
